---
/**
 * dad.astro — Unlisted birthday page available directly at `/dad/`.
 */
import Layout from '../layouts/Base.astro';
import GiftBox from '../components/GiftBox.astro';

const birthdayGifUrl = 'https://media0.giphy.com/media/v1.Y2lkPTc5MGI3NjExM2k0dXM0ZjF4NGx4YjFzZDVrYXBybndwZzFseXdkYWE2NHYxbmg0eCZlcD12MV9pbnRlcm5hbF9naWZfYnlfaWQmY3Q9Zw/6g564lKXZo796/giphy.gif';
---

<Layout
  title="Happy Birthday Dad! - Matt Serwinowski"
  description="A birthday message for Dad."
  readingProgress={false}
>
  <article class="space-y-8 py-8">
    <div class="space-y-3 text-center">
      <h1 class="text-4xl font-bold tracking-tight">Happy Birthday Dad!</h1>
      <p class="text-lg text-[var(--color-accent)]">Wishing you a wonderful birthday.</p>
    </div>

    <img
      src={birthdayGifUrl}
      alt="Pusheen celebrating a happy birthday"
      width="350"
      height="350"
      loading="eager"
      decoding="async"
      class="mx-auto block h-auto w-auto max-w-[350px] rounded-lg border border-[var(--color-border)] bg-[var(--color-surface)]"
      data-birthday-media
      data-gif-src={birthdayGifUrl}
    />

    <GiftBox>
      <div class="prose">
        <p>
          65 laps around the sun, and somehow you’re moving faster than ever.
        </p>
        <p>
          This year, you’ve walked farther, traveled more, and lifted heavier. So
          we wanted to give you something that matches your pace.
        </p>

        <p>On December 10, 2026, at Miami Homestead Speedway, you’ll experience:</p>

        <ul>
          <li>A Hellcat ride-along</li>
          <li>A Ferrari 488</li>
          <li>A Porsche 911</li>
        </ul>

        <p>Be there at 8:30 AM!</p>

        <p><strong>Happy Birthday!</strong></p>

        <p>
          Love,<br />
            Matthew, Nicole, Christian &amp; Anthony
        </p>
      </div>

      <div class="gift-cars" aria-label="Your driving experiences">
        <img
          src="/assets/dad/ferrari-488.png"
          alt="Ferrari 488 GTB Xtreme Xperience driving voucher"
          width="386"
          height="465"
          loading="lazy"
          decoding="async"
          class="gift-car gift-car--left"
        />
        <img
          src="/assets/dad/porsche-911.png"
          alt="Porsche 911 GT3 Xtreme Xperience driving voucher"
          width="392"
          height="484"
          loading="lazy"
          decoding="async"
          class="gift-car gift-car--right"
        />
      </div>
    </GiftBox>
  </article>
</Layout>
