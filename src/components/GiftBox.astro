---
/**
 * GiftBox.astro — One-way birthday gift reveal.
 *
 * The destination is passed in by the page so replacing the placeholder link
 * does not require touching the animation or accessibility behavior.
 */
interface Props {
  href: string;
  linkLabel?: string;
}

const { href, linkLabel = 'Open your birthday surprise' } = Astro.props;
---

<section class="gift-box" data-gift-box data-state="closed">
  <button
    class="gift-box__button"
    type="button"
    aria-label="Open your gift"
    aria-expanded="false"
    aria-controls="gift-box-reveal"
    data-gift-box-button
  >
    <span class="gift-box__present" aria-hidden="true">
      <span class="gift-box__lid">
        <span class="gift-box__lid-ribbon"></span>
        <span class="gift-box__bow">
          <span class="gift-box__bow-loop gift-box__bow-loop--left"></span>
          <span class="gift-box__bow-knot"></span>
          <span class="gift-box__bow-loop gift-box__bow-loop--right"></span>
        </span>
      </span>
      <span class="gift-box__body">
        <span class="gift-box__ribbon"></span>
      </span>
      <span class="gift-box__sparkles">
        <span></span>
        <span></span>
        <span></span>
      </span>
    </span>
    <span class="gift-box__prompt" data-gift-box-prompt>Open your gift</span>
  </button>

  <div
    id="gift-box-reveal"
    class="gift-box__reveal"
    aria-hidden="true"
    inert
    data-gift-box-reveal
  >
    <p role="status" aria-live="polite">Your surprise is ready!</p>
    <a href={href} tabindex="-1" data-gift-box-link>{linkLabel}</a>
  </div>

  <noscript>
    <p class="gift-box__noscript">
      <a href={href}>{linkLabel}</a>
    </p>
  </noscript>
</section>

<style>
  .gift-box {
    display: grid;
    justify-items: center;
    gap: 1.5rem;
    width: min(100%, 24rem);
    margin-inline: auto;
    text-align: center;
  }

  .gift-box__button {
    display: grid;
    justify-items: center;
    gap: 1rem;
    border: 0;
    background: transparent;
    color: var(--color-text);
    cursor: pointer;
    transition:
      opacity 2.5s ease 450ms,
      visibility 0s linear 2.95s;
  }

  .gift-box__button:focus-visible {
    outline: 3px solid var(--color-accent);
    outline-offset: 0.5rem;
    border-radius: 0.5rem;
  }

  .gift-box__present {
    position: relative;
    display: block;
    width: 11rem;
    height: 10rem;
    animation: gift-idle 2.4s ease-in-out infinite;
    filter: drop-shadow(0 1rem 1rem color-mix(in srgb, var(--color-accent) 20%, transparent));
  }

  .gift-box__body,
  .gift-box__lid {
    position: absolute;
    left: 50%;
    display: block;
    background: var(--color-accent);
    border: 2px solid color-mix(in srgb, var(--color-accent) 68%, var(--color-text));
  }

  .gift-box__body {
    bottom: 0;
    width: 9rem;
    height: 7rem;
    border-radius: 0.4rem 0.4rem 0.75rem 0.75rem;
    transform: translateX(-50%);
  }

  .gift-box__lid {
    z-index: 2;
    top: 2rem;
    width: 10rem;
    height: 2.25rem;
    border-radius: 0.45rem;
    transform: translateX(-50%);
    transform-origin: 15% 100%;
    transition: transform 650ms cubic-bezier(0.34, 1.56, 0.64, 1);
  }

  .gift-box__ribbon,
  .gift-box__lid-ribbon {
    position: absolute;
    left: 50%;
    display: block;
    width: 1.8rem;
    height: 100%;
    background: var(--color-surface);
    border-inline: 1px solid color-mix(in srgb, var(--color-accent) 45%, var(--color-border));
    transform: translateX(-50%);
  }

  .gift-box__lid-ribbon {
    top: 0;
  }

  .gift-box__bow {
    position: absolute;
    left: 50%;
    bottom: calc(100% - 0.15rem);
    display: flex;
    align-items: flex-end;
    justify-content: center;
    width: 6.5rem;
    height: 3.25rem;
    transform: translateX(-50%);
  }

  .gift-box__bow-loop {
    width: 2.8rem;
    height: 2.35rem;
    border: 0.55rem solid var(--color-surface);
    background: color-mix(in srgb, var(--color-accent) 72%, var(--color-surface));
    box-shadow: inset 0 0 0 1px color-mix(in srgb, var(--color-accent) 45%, var(--color-border));
  }

  .gift-box__bow-loop--left {
    border-radius: 75% 35% 65% 35%;
    transform: rotate(24deg) translateX(0.2rem);
  }

  .gift-box__bow-loop--right {
    border-radius: 35% 75% 35% 65%;
    transform: rotate(-24deg) translateX(-0.2rem);
  }

  .gift-box__bow-knot {
    z-index: 1;
    flex: 0 0 auto;
    width: 1.55rem;
    height: 1.55rem;
    margin-inline: -0.35rem;
    margin-bottom: 0.1rem;
    border: 0.35rem solid var(--color-surface);
    border-radius: 50%;
    background: var(--color-accent);
    box-shadow: inset 0 0 0 1px color-mix(in srgb, var(--color-accent) 45%, var(--color-border));
  }

  .gift-box__sparkles {
    position: absolute;
    inset: 0;
    opacity: 0;
    transition: opacity 180ms ease 220ms;
  }

  .gift-box__sparkles span {
    position: absolute;
    display: block;
    width: 0.65rem;
    height: 0.65rem;
    border-radius: 50%;
    background: var(--color-accent-hover);
    transform: scale(0);
  }

  .gift-box__sparkles span:nth-child(1) {
    top: 1rem;
    left: 1.5rem;
  }

  .gift-box__sparkles span:nth-child(2) {
    top: 0;
    right: 1.25rem;
  }

  .gift-box__sparkles span:nth-child(3) {
    top: 2.4rem;
    right: 0.15rem;
  }

  .gift-box__prompt {
    font-family: var(--font-mono);
    font-size: var(--font-size-sm);
    color: var(--color-muted);
  }

  .gift-box__reveal {
    display: grid;
    gap: 0.6rem;
    width: 100%;
    padding: 1.25rem;
    border: 1px solid var(--color-border);
    border-radius: 0.75rem;
    background: var(--color-surface);
    opacity: 0;
    visibility: hidden;
    transform: translateY(-1rem) scale(0.96);
    transition:
      opacity 300ms ease 420ms,
      transform 420ms cubic-bezier(0.34, 1.56, 0.64, 1) 420ms,
      visibility 0s linear 720ms;
    pointer-events: none;
  }

  .gift-box__reveal p {
    font-weight: 600;
    color: var(--color-text);
  }

  .gift-box__reveal a,
  .gift-box__noscript a {
    font-weight: 600;
  }

  .gift-box[data-state="open"] .gift-box__present {
    animation: gift-pop 620ms cubic-bezier(0.34, 1.56, 0.64, 1) both;
  }

  .gift-box[data-state="open"] .gift-box__button {
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    cursor: default;
  }

  .gift-box[data-state="open"] .gift-box__lid {
    transform: translateX(-65%) translateY(-4.5rem) rotate(-24deg);
  }

  .gift-box[data-state="open"] .gift-box__sparkles {
    opacity: 1;
  }

  .gift-box[data-state="open"] .gift-box__sparkles span {
    animation: gift-sparkle 600ms ease-out 180ms both;
  }

  .gift-box[data-state="open"] .gift-box__sparkles span:nth-child(2) {
    animation-delay: 250ms;
  }

  .gift-box[data-state="open"] .gift-box__sparkles span:nth-child(3) {
    animation-delay: 320ms;
  }

  .gift-box[data-state="open"] .gift-box__reveal {
    opacity: 1;
    visibility: visible;
    transform: translateY(0) scale(1);
    transition-delay: 420ms, 420ms, 0s;
    pointer-events: auto;
  }

  @keyframes gift-idle {
    0%, 100% { transform: translateY(0) rotate(-1deg); }
    50% { transform: translateY(-0.45rem) rotate(1deg); }
  }

  @keyframes gift-pop {
    0% { transform: translateY(0) scale(1); }
    45% { transform: translateY(-0.8rem) scale(1.06); }
    100% { transform: translateY(0) scale(1); }
  }

  @keyframes gift-sparkle {
    0% { opacity: 0; transform: scale(0) translateY(0); }
    45% { opacity: 1; transform: scale(1.35) translateY(-0.75rem); }
    100% { opacity: 0; transform: scale(0.6) translateY(-1.75rem); }
  }

  @media (prefers-reduced-motion: reduce) {
    .gift-box__present,
    .gift-box[data-state="open"] .gift-box__present,
    .gift-box[data-state="open"] .gift-box__sparkles span {
      animation: none;
    }

    .gift-box__button,
    .gift-box__lid,
    .gift-box__sparkles,
    .gift-box__reveal {
      transition-duration: 0.12s;
      transition-delay: 0s;
    }

    .gift-box[data-state="open"] .gift-box__lid {
      transform: translateX(-50%) translateY(-2.5rem);
    }
  }
</style>

<script>
  function setupGiftBoxes() {
    document.querySelectorAll<HTMLElement>('[data-gift-box]').forEach((root) => {
      if (root.dataset.giftBoxBound === 'true') return;

      const button = root.querySelector<HTMLButtonElement>('[data-gift-box-button]');
      const reveal = root.querySelector<HTMLElement>('[data-gift-box-reveal]');
      const link = root.querySelector<HTMLAnchorElement>('[data-gift-box-link]');
      const prompt = root.querySelector<HTMLElement>('[data-gift-box-prompt]');
      if (!button || !reveal || !link || !prompt) return;

      root.dataset.giftBoxBound = 'true';
      button.addEventListener('click', () => {
        if (root.dataset.state === 'open') return;

        root.dataset.state = 'open';
        button.disabled = true;
        button.tabIndex = -1;
        button.setAttribute('aria-expanded', 'true');
        button.setAttribute('aria-label', 'Gift opened');
        reveal.setAttribute('aria-hidden', 'false');
        reveal.inert = false;
        link.tabIndex = 0;
        prompt.textContent = 'Gift opened!';
      });
    });
  }

  const giftBoxWindow = window as Window & { __giftBoxPageLoadBound?: boolean };
  if (!giftBoxWindow.__giftBoxPageLoadBound) {
    document.addEventListener('astro:page-load', setupGiftBoxes);
    giftBoxWindow.__giftBoxPageLoadBound = true;
  }
  setupGiftBoxes();
</script>
